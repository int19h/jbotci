{
  "name": "jbotci-lojban",
  "displayName": "jbotci Lojban",
  "description": "Lojban language support powered by the jbotci language server.",
  "version": "0.1.0",
  "publisher": "int19h",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/int19h/jbotci.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lojban",
    "onLanguage:markdown",
    "onCommand:jbotci.restartServer"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --project tsconfig.json && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "lint": "eslint src --max-warnings 0",
    "smoke": "node ./scripts/smoke-server.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "1.82.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "lojban",
        "aliases": [
          "Lojban"
        ],
        "extensions": [
          ".jbo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "jbotci.restartServer",
        "title": "Restart jbotci Language Server",
        "category": "jbotci"
      }
    ],
    "configuration": {
      "title": "jbotci",
      "properties": {
        "jbotci.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the jbotci executable. When empty, the extension uses jbotci from PATH."
        },
        "jbotci.enableInAllMarkdown": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Enable jbotci language features in every Markdown document. Markdown URLs, code fences, and HTML can produce noisy diagnostics until structural Markdown support is available."
        }
      }
    }
  }
}
