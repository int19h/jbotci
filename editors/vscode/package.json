{
  "name": "jbotci-lojban",
  "displayName": "jbotci Lojban",
  "description": "Lojban language support powered by the jbotci language server.",
  "version": "0.1.0",
  "publisher": "int19h",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/int19h/jbotci.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lojban",
    "onLanguage:markdown",
    "onCommand:jbotci.restartServer"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --project tsconfig.json && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "lint": "eslint src --max-warnings 0",
    "smoke": "node ./scripts/smoke-server.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "1.82.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "lojban",
        "aliases": [
          "Lojban"
        ],
        "extensions": [
          ".jbo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "jbotci.restartServer",
        "title": "Restart jbotci Language Server",
        "category": "jbotci"
      }
    ],
    "configuration": {
      "title": "jbotci",
      "properties": {
        "jbotci.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the jbotci executable. When empty, the extension uses jbotci from PATH."
        },
        "jbotci.enableInAllMarkdown": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Enable jbotci language features in every Markdown document. Markdown URLs, code fences, and HTML can produce noisy diagnostics until structural Markdown support is available."
        },
        "jbotci.inlays": {
          "type": "object",
          "default": {
            "structureBrackets": true,
            "wordBoundaries": false,
            "rafsiBoundaries": false
          },
          "scope": "window",
          "additionalProperties": false,
          "description": "Configure each jbotci inlay kind independently. Changing this setting restarts the language server.",
          "properties": {
            "structureBrackets": {
              "default": true,
              "description": "Show recovered syntax structure brackets. Use false to disable, true for defaults, or an object for profile options.",
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile"
                  ],
                  "properties": {
                    "profile": {
                      "type": "string",
                      "enum": [
                        "raw-brackets"
                      ]
                    },
                    "maxNestingDepth": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "One-based maximum structure depth. Zero suppresses all structure brackets."
                    },
                    "constructs": {
                      "type": "string",
                      "default": "all",
                      "enum": [
                        "all",
                        "sumti-boundaries",
                        "bridi-tails"
                      ]
                    }
                  }
                }
              ]
            },
            "wordBoundaries": {
              "type": "boolean",
              "default": false,
              "description": "Show '-' between consecutive morphology words with no source gap."
            },
            "rafsiBoundaries": {
              "type": "boolean",
              "default": false,
              "description": "Show '·' between every parsed lujvo part, including hyphens."
            }
          }
        }
      }
    }
  }
}
