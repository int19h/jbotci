def _dialect_dialect_name_shows_in_gentufa_picker(name: str) -> bool: ...
def _dialect_dialect_formula_top_level_references(formula_text: str) -> tuple[str, ...]: ...
def _dialect_add_dialect_formula_reference(dialect_name: str, formula_text: str) -> str: ...
