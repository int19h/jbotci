from collections.abc import Sequence
from typing import Never, final

@final
class _dialect_CmavoSwap:
    __match_args__: tuple[str, str]
    def __new__(cls, left: str, right: str) -> _dialect_CmavoSwap: ...
    @property
    def left(self) -> str: ...
    @property
    def right(self) -> str: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class _dialect_CmavoExpansion:
    __match_args__: tuple[str, str]
    def __new__(cls, source: str, replacement: Sequence[str]) -> _dialect_CmavoExpansion: ...
    @property
    def source(self) -> str: ...
    @property
    def replacement(self) -> tuple[str, ...]: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class _dialect_DialectDefinition:
    def __new__(
        cls,
        cmavo_entries: Sequence[_dialect_CmavoSwap | _dialect_CmavoExpansion] | None = ...,
        features: Sequence[_dialect_DialectFeature] | None = ...,
    ) -> _dialect_DialectDefinition: ...
    @staticmethod
    def baseline() -> _dialect_DialectDefinition: ...
    @property
    def cmavo_entries(self) -> tuple[_dialect_CmavoSwap | _dialect_CmavoExpansion, ...]: ...
    @property
    def features(self) -> tuple[_dialect_DialectFeature, ...]: ...
    def is_baseline(self) -> bool: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class _dialect_BuiltinDialect:
    def __new__(cls, _nonconstructible: Never) -> _dialect_BuiltinDialect: ...
    @property
    def name(self) -> str: ...
    @property
    def definition(self) -> str: ...
    @property
    def dialect(self) -> _dialect_DialectDefinition: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class _dialect_CustomDialect:
    def __new__(
        cls,
        name: str,
        definition: str,
        *,
        show_in_gentufa: bool = ...,
    ) -> _dialect_CustomDialect: ...
    @property
    def name(self) -> str: ...
    @property
    def definition(self) -> str: ...
    @property
    def show_in_gentufa(self) -> bool: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class _dialect_DialectSettings:
    def __new__(
        cls,
        custom_dialects: Sequence[_dialect_CustomDialect] = ...,
        hidden_builtin_gentufa_dialects: Sequence[str] = ...,
    ) -> _dialect_DialectSettings: ...
    @property
    def custom_dialects(self) -> tuple[_dialect_CustomDialect, ...]: ...
    @property
    def hidden_builtin_gentufa_dialects(self) -> tuple[str, ...]: ...
    def __eq__(self, value: object, /) -> bool: ...

def _dialect_parse_dialect_definition(source: str) -> _dialect_DialectDefinition: ...
def _dialect_builtin_dialects() -> tuple[_dialect_BuiltinDialect, ...]: ...
def _dialect_builtin_dialect_names() -> tuple[str, ...]: ...
def _dialect_find_builtin_dialect(name: str) -> _dialect_BuiltinDialect | None: ...
def _dialect_parse_dialect_definition_with_custom_dialects(
